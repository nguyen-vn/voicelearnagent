# ===== VoiceLearn Agent – cấu hình =====
# Sao chép file này thành .env rồi điền API key.
# Để trống key => app tự chạy ở MOCK MODE (không gọi API, dùng để học/test).

GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Ép chạy mock kể cả khi đã có key (1 = bật)
MOCK_MODE=0

# ----- LLM (Gemini) -----
GEMINI_MODEL=gemini-3.8-flash

# ----- ElevenLabs -----
# STT: scribe_v2 (hỗ trợ tiếng Việt)
ELEVENLABS_STT_MODEL=scribe_v2
# TTS: eleven_flash_v2_5 (nhanh, rẻ, có tiếng Việt) hoặc eleven_v3 (tự nhiên hơn)
# Lưu ý: eleven_multilingual_v2 KHÔNG hỗ trợ tiếng Việt.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Voice ID giọng nữ / nam (lấy danh sách bằng: python scripts/list_voices.py)
VOICE_FEMALE_ID=XrExE9yKIg1WjnnlVkGX
VOICE_MALE_ID=JBFqnCBsd6RMkjVDRZzb
# (Tuỳ chọn) giọng bản ngữ tiếng Việt lấy từ Voice Library – để trống thì dùng 2 giọng trên
VOICE_VI_FEMALE_ID=
VOICE_VI_MALE_ID=

# Giới hạn số ký tự đọc thành giọng nói mỗi lần (tiết kiệm credit)
TTS_MAX_CHARS=1500
